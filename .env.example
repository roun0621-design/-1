# Pace Rise Competition OS — 환경 설정 템플릿
# 이 파일을 복사해서 .env로 만들고 실제 값을 입력하세요
# cp .env.example .env

# 서버 포트
PORT=3000

# 관리자 계정 (반드시 변경하세요!)
ADMIN_ID=YOUR_ADMIN_ID
ADMIN_PW=YOUR_SECURE_PASSWORD

# 기본 운영키 (반드시 변경하세요!)
OPERATION_KEY=YOUR_OPERATION_KEY

# ───────────────────────────────────────────────────────────────
# 오프사이트(원격) 백업 — AWS S3
# BACKUP_S3_BUCKET 을 설정하면 로컬 backups/ 백업이 S3로도 복제됩니다.
# (미설정 시 오프사이트 백업은 꺼지고 로컬 백업만 동작)
# 자격증명은 EC2 IAM 역할(권장) 또는 표준 AWS_ACCESS_KEY_ID/SECRET 환경변수 사용.
# ───────────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=pacerise-backups/      # 키 접두사 (기본값)
# BACKUP_S3_REGION=ap-northeast-2         # 없으면 AWS_REGION → 없으면 ap-northeast-2
# BACKUP_S3_SSE=AES256                    # 서버측 암호화 (AES256 | aws:kms | off)
